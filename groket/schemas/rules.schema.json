{
  "$defs": {
    "CompositeDefinition": {
      "description": "One composite under ``composites:``.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "default": "",
          "title": "Name",
          "type": "string"
        },
        "severity": {
          "default": "medium",
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Severity",
          "type": "string"
        },
        "child_rules": {
          "items": {
            "type": "string"
          },
          "title": "Child Rules",
          "type": "array"
        },
        "relationship": {
          "default": "co_occurrence",
          "title": "Relationship",
          "type": "string"
        },
        "min_repeat": {
          "default": 3,
          "title": "Min Repeat",
          "type": "integer"
        },
        "max_gap": {
          "default": 5,
          "title": "Max Gap",
          "type": "integer"
        },
        "root_cause": {
          "default": "",
          "title": "Root Cause",
          "type": "string"
        },
        "should_have": {
          "default": "",
          "title": "Should Have",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "CompositeDefinition",
      "type": "object"
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ]
    },
    "RuleDefinition": {
      "description": "One detection rule under ``rules:`` (or a bare list root).",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "category": {
          "default": "Uncategorized",
          "title": "Category",
          "type": "string"
        },
        "severity": {
          "default": "medium",
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Severity",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "detector": {
          "default": "",
          "title": "Detector",
          "type": "string"
        },
        "params": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Params",
          "type": "object"
        },
        "summary": {
          "default": "",
          "title": "Summary",
          "type": "string"
        },
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        },
        "recommendation": {
          "default": "",
          "title": "Recommendation",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "RuleDefinition",
      "type": "object"
    }
  },
  "description": "Root document for a rules YAML file (rules and/or composites).",
  "properties": {
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "rules": {
      "items": {
        "$ref": "#/$defs/RuleDefinition"
      },
      "title": "Rules",
      "type": "array"
    },
    "composites": {
      "items": {
        "$ref": "#/$defs/CompositeDefinition"
      },
      "title": "Composites",
      "type": "array"
    }
  },
  "title": "groket-rules",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://indynull.github.io/groket/schemas/rules.schema.json"
}
